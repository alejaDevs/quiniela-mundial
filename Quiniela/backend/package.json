{
  "name": "quiniela-mundial-2026-backend",
  "version": "1.0.0",
  "description": "Backend API for the World Cup 2026 betting pool",
  "main": "dist/Server.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "start": "node dist/Server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/Server.ts",
    "seed": "ts-node --transpile-only src/scripts/seedMatches.ts",
    "seed:round32": "ts-node --transpile-only src/scripts/seedRound32.ts",
    "seed:round16": "ts-node --transpile-only src/scripts/seedRound16.ts",
    "link:bracket": "ts-node --transpile-only src/scripts/linkBracketMatches.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "node-cron": "^4.5.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
